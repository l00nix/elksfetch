+elksfetch()
+{
+    echo "Building ELKSfetch..."
+    cd "$TOPDIR/extapps"
+    if [ ! -d elksfetch ] ; then
+        git clone https://github.com/l00nix/elksfetch.git elksfetch
+    fi
+    cd elksfetch
+    git pull --ff-only
+    ELKSFETCH_ELKS="$TOPDIR" sh toolchain/build-external.sh
+    echo "ELKSfetch build complete"
+}
